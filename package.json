{
  "name": "cesium-gpu-points-layer",
  "version": "0.3.6",
  "description": "High-performance Cesium GPU point rendering layer using packed textures and custom point sprites.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "demo": "npm run demo:dev",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts --host 0.0.0.0 --port 4173",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "test": "npm run build && node --test ./tests/**/*.test.mjs",
    "test:unit": "npm run build && node --test ./tests/unit/**/*.test.mjs",
    "test:integration": "npm run build && node --test ./tests/integration/**/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "cesium": "^1.139.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "cesium": "^1.139.0",
    "rimraf": "^6.0.1",
    "stats.js": "^0.17.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vadimrostok/cesium-gpu-points-layer.git"
  },
  "keywords": [
    "cesium",
    "gpu sprites",
    "gpu points",
    "GIS",
    "performance",
    "packed textures",
    "custom point sprites"
  ],
  "author": "Vadym Rostok",
  "homepage": "https://github.com/vadimrostok/cesium-gpu-points-layer#readme"
}
